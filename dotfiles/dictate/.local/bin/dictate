#!/usr/bin/env bash
set -euo pipefail

if command -v desktopctl >/dev/null 2>&1; then
  if native_binary=$(desktopctl path dictate 2>/dev/null) && [[ $native_binary != "$HOME/.local/bin/dictate" ]]; then exec "$native_binary" "$@"; fi
fi
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/dictate"
if [[ ! -x "$cache_root/bin/dictate" ]]; then
  "${BASH_SOURCE[0]%/*}/dictate-build"
fi
exec "$cache_root/bin/dictate" "$@"
