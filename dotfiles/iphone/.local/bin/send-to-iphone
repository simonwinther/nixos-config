#!/usr/bin/env python3
"""Send selected files to the iPhone using Tailscale Taildrop."""

import json
import subprocess
import sys
from pathlib import Path


def error(message):
    subprocess.run(
        ["zenity", "--error", "--no-markup", "--title=Send to iPhone",
         "--width=500", f"--text={message}"], check=False
    )
    raise SystemExit(1)


def main():
    try:
        settings = json.loads(
            (Path.home() / ".config/taildrop/iphone.json").read_text()
        )
        target = settings["target"]
        if not isinstance(target, str) or not target:
            raise ValueError("The iPhone address is missing.")
    except (OSError, ValueError, KeyError) as exc:
        error(f"Could not read your iPhone settings:\n{exc}")

    if sys.argv[1:] == ["--check"]:
        status = subprocess.run(
            ["tailscale", "status", "--json"], capture_output=True,
            text=True, check=True, timeout=15
        )
        state = json.loads(status.stdout)
        peers = [p for p in state.get("Peer", {}).values()
                 if target in p.get("TailscaleIPs", [])]
        if state.get("BackendState") != "Running" or not peers:
            raise SystemExit("The configured iPhone is not in your active tailnet.")
        name = peers[0].get("DNSName", "").split(".")[0] or settings["name"]
        print(f"iPhone: {name} ({target})")
        print(f"Online: {peers[0].get('Online', False)}")
        return

    selected = sys.argv[1:]
    if not selected:
        picker = subprocess.run(
            ["zenity", "--file-selection", "--multiple", "--separator=\n",
             "--title=Choose files to send to iPhone", "--width=960",
             "--height=720", f"--filename={Path.home()}/"],
            capture_output=True, text=True, check=False
        )
        if picker.returncode:
            return
        selected = picker.stdout.rstrip("\n").split("\n")

    paths = [Path(p).absolute() for p in selected]
    invalid = [p for p in paths if not p.is_file()]
    if invalid:
        error("Choose files to send. Folders cannot be sent with Taildrop.\n\n"
              + "\n".join(str(p) for p in invalid[:5]))

    progress = subprocess.Popen(
        ["zenity", "--progress", "--pulsate", "--auto-close", "--no-cancel",
         "--title=Send to iPhone",
         f"--text=Sending {len(paths)} file(s) to your iPhone..."],
        stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, text=True
    )
    try:
        transfer = subprocess.run(
            ["tailscale", "file", "cp", "--update-interval=0",
             *map(str, paths), f"{target}:"],
            capture_output=True, text=True, check=False
        )
    finally:
        if progress.stdin:
            progress.stdin.close()
        try:
            progress.wait(timeout=3)
        except subprocess.TimeoutExpired:
            progress.terminate()
            progress.wait()

    if transfer.returncode:
        detail = transfer.stderr.strip() or transfer.stdout.strip()
        error("The transfer did not finish. Make sure Tailscale is connected "
              "on your iPhone, then try again.\n\n" + detail[-2000:])

    subprocess.run(
        ["notify-send", "--app-name=File Sharing", "--icon=phone",
         "Sent to iPhone", f"{len(paths)} file(s) sent. Open the Tailscale "
         "notification on your iPhone to find them in Files."], check=False
    )


if __name__ == "__main__":
    main()
