#!/usr/bin/env python3
"""Receive Taildrop files and organize them by type."""

import errno
import http.client
import json
import mimetypes
import shutil
import socket
import subprocess
import tempfile
import time
from contextlib import contextmanager
from pathlib import Path
from urllib.parse import quote


ROOT = Path.home() / "From iPhone"
SOCKET = "/run/tailscale/tailscaled.sock"
CATEGORIES = ("Pictures", "Videos", "Documents", "Audio", "Files")
DOCUMENT_EXTENSIONS = {
    ".pdf", ".doc", ".docx", ".odt", ".rtf", ".xls", ".xlsx", ".ods",
    ".ppt", ".pptx", ".odp", ".pages", ".numbers", ".key", ".epub",
    ".txt", ".md", ".csv", ".json", ".xml", ".yaml", ".yml",
}


class LocalAPI(http.client.HTTPConnection):
    def __init__(self):
        super().__init__("local-tailscaled.sock", timeout=45)

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(SOCKET)


@contextmanager
def request(method, path, expected=200):
    connection = LocalAPI()
    try:
        connection.request(method, "/localapi/v0/files/" + path)
        response = connection.getresponse()
        if response.status != expected:
            detail = response.read(2000).decode(errors="replace").strip()
            raise RuntimeError(f"Tailscale returned {response.status}: {detail}")
        yield response
    finally:
        connection.close()


def category(source, name):
    mime = mimetypes.guess_type(name)[0]
    if mime is None or mime == "application/octet-stream":
        detected = subprocess.run(
            ["file", "--brief", "--mime-type", "--", str(source)],
            capture_output=True, text=True, check=False, timeout=10
        )
        mime = detected.stdout.strip() if detected.returncode == 0 else ""
    for prefix, folder in [("image/", "Pictures"), ("video/", "Videos"),
                           ("audio/", "Audio"), ("text/", "Documents")]:
        if mime.startswith(prefix):
            return folder
    if Path(name).suffix.lower() in DOCUMENT_EXTENSIONS:
        return "Documents"
    return "Files"


def organize(source, name):
    if not name or Path(name).name != name or name in {".", ".."}:
        raise ValueError("The received filename is invalid.")
    destination = ROOT / category(source, name)
    destination.mkdir(mode=0o700, parents=True, exist_ok=True)
    filename = Path(name)
    counter = 0
    while True:
        candidate = destination / (
            name if counter == 0 else f"{filename.stem} ({counter}){filename.suffix}"
        )
        try:
            # The staging directory and final folders share the same filesystem.
            # Linking publishes a completed file without replacing an existing one.
            candidate.hardlink_to(source)
        except FileExistsError:
            counter += 1
            continue
        except OSError as exc:
            if exc.errno == errno.EXDEV:
                raise RuntimeError("The receiving folders must share a filesystem.") from exc
            raise
        source.unlink()
        return candidate


def receive(item):
    name = item["Name"]
    if not isinstance(name, str) or not name or Path(name).name != name:
        raise ValueError("The received filename is invalid.")
    path = quote(name, safe="")
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            prefix="receive-", suffix=".part", dir=ROOT / ".incoming", delete=False
        ) as output:
            temporary = Path(output.name)
            with request("GET", path) as response:
                expected = int(response.getheader("Content-Length", item["Size"]))
                shutil.copyfileobj(response, output, length=1024 * 1024)
                if output.tell() != expected or output.tell() != item["Size"]:
                    raise RuntimeError(f"The transfer of {name!r} was incomplete.")
        destination = organize(temporary, name)
        with request("DELETE", path, expected=204):
            pass
        print(f"Received {name!r} into {str(destination)!r}", flush=True)
        return destination
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def main():
    ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    (ROOT / ".incoming").mkdir(mode=0o700, exist_ok=True)
    for folder in CATEGORIES:
        (ROOT / folder).mkdir(mode=0o700, exist_ok=True)
    for stale in (ROOT / ".incoming").glob("receive-*.part"):
        stale.unlink()
    while True:
        try:
            with request("GET", "?waitsec=30") as response:
                pending = json.load(response) or []
            for item in pending:
                receive(item)
        except (OSError, ValueError, KeyError, RuntimeError, http.client.HTTPException,
                subprocess.TimeoutExpired) as exc:
            print(f"Could not receive files: {exc}", flush=True)
            time.sleep(5)


if __name__ == "__main__":
    main()
