--- a/net/netmon/uplink_linux.go
+++ b/net/netmon/uplink_linux.go
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build !android
+
+package netmon
+
+import (
+	"bufio"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// Docker bridges and other VPN clients' tunnels keep IPv4 addresses after the
+// physical link drops. Counting them made AnyInterfaceUp report a network, so
+// tailscaled never paused while offline and retried netcheck, DERP and control
+// every few seconds. None of them can carry tailscaled's traffic on its own;
+// default route changes are still tracked separately.
+func init() {
+	IsInterestingInterface = func(iface Interface, _ []netip.Prefix) bool {
+		return !isLocalOnlyOrOverlayInterface(iface.Name)
+	}
+}
+
+func isLocalOnlyOrOverlayInterface(name string) bool {
+	if isDockerInterfaceName(name) {
+		return true
+	}
+	sysfs := filepath.Join("/sys/class/net", name)
+	if _, err := os.Stat(filepath.Join(sysfs, "tun_flags")); err == nil {
+		return true
+	}
+	return sysfsDevType(sysfs) == "wireguard"
+}
+
+func isDockerInterfaceName(name string) bool {
+	if name == "docker0" || strings.HasPrefix(name, "veth") {
+		return true
+	}
+	networkID, ok := strings.CutPrefix(name, "br-")
+	if !ok || len(networkID) != 12 {
+		return false
+	}
+	for _, c := range networkID {
+		if !strings.ContainsRune("0123456789abcdef", c) {
+			return false
+		}
+	}
+	return true
+}
+
+func sysfsDevType(sysfs string) string {
+	f, err := os.Open(filepath.Join(sysfs, "uevent"))
+	if err != nil {
+		return ""
+	}
+	defer f.Close()
+	scanner := bufio.NewScanner(f)
+	for scanner.Scan() {
+		if devType, ok := strings.CutPrefix(scanner.Text(), "DEVTYPE="); ok {
+			return devType
+		}
+	}
+	return ""
+}
