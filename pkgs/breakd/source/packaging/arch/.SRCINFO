pkgbase = breakd
	pkgver = 0.1.12
	pkgrel = 1
	url = https://github.com/simonwinther/breakd
	arch = x86_64
	license = MIT
	license = BSD-2-Clause
	makedepends = cargo
	makedepends = pkgconf
	options = !debug
