+
+        // Agent CLIs prefix titles with an animated status glyph (U+2000-U+2FFF, such as a
+        // braille spinner) that names nothing. Shells title windows with their directory, whose
+        // end names the place, so keep its last two components before the badge is shortened.
+        std::string displayTitle(std::string title) {
+            const auto* BYTES = reinterpret_cast<const unsigned char*>(title.data());
+            if (title.size() > 4 && BYTES[0] == 0xE2 && title[3] == ' ') {
+                const unsigned CODEPOINT = ((BYTES[0] & 0x0Fu) << 12) | ((BYTES[1] & 0x3Fu) << 6) | (BYTES[2] & 0x3Fu);
+                if (CODEPOINT != 0x2026)
+                    title.erase(0, title.find_first_not_of(' ', 3));
+            }
+            if (title.starts_with('/') || title.starts_with('~') || title.starts_with("\u2026/")) {
+                std::vector<std::string> parts;
+                for (size_t start = 0; start < title.size();) {
+                    const size_t END = std::min(title.find('/', start), title.size());
+                    if (END > start)
+                        parts.emplace_back(title.substr(start, END - start));
+                    start = END + 1;
+                }
+                if (parts.size() > 2)
+                    title = "\u2026/" + parts[parts.size() - 2] + "/" + parts.back();
+            }
+            return title;
+        }
+
+        // Window titles read as captions, so they use the overview font at a smaller size.
+        std::string captionFont(const std::string& font) {
+            const auto SPACE = font.find_last_of(' ');
+            if (SPACE == std::string::npos)
+                return font;
+            try {
+                const double SIZE = std::stod(font.substr(SPACE + 1));
+                return font.substr(0, SPACE + 1) + std::to_string(std::max(8, static_cast<int>(std::lround(SIZE * 0.8))));
+            } catch (...) { return font; }
+        }
