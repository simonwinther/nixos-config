+
+func copySelection(cmd *exec.Cmd, pasteCommand string) error {
+	// wl-copy exits after its background process owns the Wayland selection.
+	if err := cmd.Run(); err != nil {
+		return err
+	}
+	if pasteCommand == "" {
+		return nil
+	}
+	return exec.Command("sh", "-c", pasteCommand).Run()
+}
--- /dev/null
+++ b/internal/providers/clipboard/desktop_paste_test.go
@@ -0,0 +1,41 @@
+package main
+
+import (
+    "bytes"
+    "fmt"
+    "os"
+    "os/exec"
+    "path/filepath"
+    "testing"
+)
+
+func TestClipboardPasteWaitsForCopyAndCopyOnlyDoesNotPaste(t *testing.T) {
+    for _, paste := range []bool{false, true} {
+        t.Run(fmt.Sprint(paste), func(t *testing.T) {
+            dir := t.TempDir()
+            copied, pasted := filepath.Join(dir, "copied"), filepath.Join(dir, "pasted")
+            payload := []byte{0, 1, 255, '\n'}
+            cmd := exec.Command("sh", "-c", fmt.Sprintf("cat > %q", copied))
+            cmd.Stdin = bytes.NewReader(payload)
+            pasteCommand := ""
+            if paste {
+                pasteCommand = fmt.Sprintf("test -s %q && printf pasted > %q", copied, pasted)
+            }
+            if err := copySelection(cmd, pasteCommand); err != nil { t.Fatal(err) }
+            data, err := os.ReadFile(copied)
+            if err != nil || !bytes.Equal(data, payload) { t.Fatalf("copy changed payload: %v", err) }
+            _, err = os.Stat(pasted)
+            if paste && err != nil { t.Fatal("paste did not run after copy", err) }
+            if !paste && !os.IsNotExist(err) { t.Fatal("copy-only invoked paste") }
+        })
+    }
+}
+
+func TestClipboardFailedCopyNeverPastes(t *testing.T) {
+    pasted := filepath.Join(t.TempDir(), "pasted")
+    cmd := exec.Command("sh", "-c", "exit 1")
+    if err := copySelection(cmd, fmt.Sprintf("printf pasted > %q", pasted)); err == nil {
+        t.Fatal("failed copy reported success")
+    }
+    if _, err := os.Stat(pasted); !os.IsNotExist(err) { t.Fatal("pasted after failed copy") }
+}
