--- /dev/null
+++ b/internal/providers/clipboard/desktop_locking_test.go
@@ -0,0 +1,47 @@
+package main
+
+import (
+    "path/filepath"
+    "testing"
+    "time"
+)
+
+func TestClipboardMutatingActionsReleaseHistoryLock(t *testing.T) {
+    oldFile, oldConfig, oldHistory := file, config, clipboardhistory
+    t.Cleanup(func() { file, config, clipboardhistory = oldFile, oldConfig, oldHistory })
+    file = filepath.Join(t.TempDir(), "history.gob")
+    config = &Config{MaxItems: 100}
+    for _, action := range []string{ActionPin, ActionUnpin, ActionRemove, ActionRemoveAll} {
+        t.Run(action, func(t *testing.T) {
+            clipboardhistory = map[string]*Item{"item": {Content: "lock regression"}}
+            done := make(chan struct{})
+            go func() {
+                Activate(false, "item", action, "", "", 0, nil)
+                Query(nil, "", false, false, 0)
+                close(done)
+            }()
+            select {
+            case <-done:
+            case <-time.After(time.Second):
+                t.Fatalf("%s blocked subsequent history queries", action)
+            }
+        })
+    }
+}
+
+func TestClipboardSaveNotificationsNeverBlockCollector(t *testing.T) {
+    old := saveFileChan
+    t.Cleanup(func() { saveFileChan = old })
+    saveFileChan = make(chan struct{}, 1)
+    mu.Lock()
+    defer mu.Unlock()
+    requestSave()
+    done := make(chan struct{})
+    go func() { requestSave(); close(done) }()
+    select {
+    case <-done:
+    case <-time.After(time.Second):
+        t.Fatal("collector blocked while a history save was already queued")
+    }
+    if len(saveFileChan) != 1 { t.Fatal("missing queued history save") }
+}
