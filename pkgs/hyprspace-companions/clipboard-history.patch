+package main
+
+import (
+    "os"
+    "path/filepath"
+    "testing"
+    "time"
+)
+
+func TestClipboardBurstTrimKeepsPinned(t *testing.T) {
+    oldFile, oldConfig, oldHistory := file, config, clipboardhistory
+    t.Cleanup(func() { file, config, clipboardhistory = oldFile, oldConfig, oldHistory })
+    file = filepath.Join(t.TempDir(), "history.gob")
+    config = &Config{MaxItems: 2}
+    clipboardhistory = map[string]*Item{
+        "pin": {Content: "pinned", Pinned: true, Time: time.Unix(0, 0)},
+        "old": {Content: "old", Time: time.Unix(1, 0)},
+        "mid": {Content: "mid", Time: time.Unix(2, 0)},
+        "new": {Content: "new", Time: time.Unix(3, 0)},
+    }
+    saveToFileLocked()
+    if len(clipboardhistory) != 2 || clipboardhistory["pin"] == nil || clipboardhistory["new"] == nil {
+        t.Fatalf("wrong retained entries: %#v", clipboardhistory)
+    }
+    clipboardhistory = map[string]*Item{"a": {Pinned: true}, "b": {Pinned: true}}
+    if trim() { t.Fatal("trim removed a pinned entry") }
+    clipboardhistory = map[string]*Item{}
+    if trim() { t.Fatal("trim removed an entry from empty history") }
+}
+
+func TestClipboardImagesAreDistinctAndPrivate(t *testing.T) {
+    t.Setenv("XDG_CACHE_HOME", t.TempDir())
+    first, second := saveImg([]byte("first"), "png"), saveImg([]byte("second"), "png")
+    if first == "" || second == "" || first == second { t.Fatal("images collided") }
+    for path, want := range map[string]string{first: "first", second: "second"} {
+        got, err := os.ReadFile(path)
+        if err != nil || string(got) != want { t.Fatalf("image changed: %s: %v", path, err) }
+        info, err := os.Stat(path)
+        if err != nil || info.Mode().Perm() != 0o600 { t.Fatalf("image is not private: %s", path) }
+    }
+}
